{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "gbl-ds-elements",
  "main": "workers/mcp.ts",
  "compatibility_date": "2025-04-01",
  "env": {
    // Dev: every commit to main → canary.elements.reapit.com.au
    "dev": {
      "name": "gbl-ds-elements-dev",
      "compatibility_flags": ["nodejs_compat"],
      "routes": [
        {
          "pattern": "canary.elements.reapit.com.au",
          "custom_domain": true,
        },
      ],
      "assets": {
        "directory": "./public/dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
      },
    },
    // Prod stable: npm publish via release.yml → elements.reapit.com.au
    "prod": {
      "name": "gbl-ds-elements-prod",
      "compatibility_flags": ["nodejs_compat"],
      "routes": [
        {
          "pattern": "elements.reapit.com.au",
          "custom_domain": true,
        },
      ],
      "assets": {
        "directory": "./public/dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
      },
    },
  },
}
