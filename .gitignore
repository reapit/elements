# Anchoring convention
#
# A slash anywhere but the end anchors a pattern to this file's directory. In a
# workspaces monorepo that distinction decides whether a pattern reaches inside
# packages/*, so declare the intent on every pattern containing a slash:
#
#   **/foo/bar   matches at any depth, including inside every workspace
#   /foo/bar     matches the repo root only
#   foo/bar      root only, but silently: never write this
#
# Single-segment patterns such as `dist/` and `*.log` already match at any depth,
# so prefixing those with `**/` changes nothing.

# Node
node_modules/
*.log
npm-debug.log*

# Yarn
/.yarn/*
!yarn.lock
!/.yarn/patches
!/.yarn/releases
!/.yarn/plugins
!/.yarn/sdks
!/.yarn/versions
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Vite
.vite/
dist/
**/public/dist
.env

# Python
__pycache__
*.py[cod]
.python-version

# Storybook
storybook-static
**/.storybook/preview.d.ts
**/.storybook/preview.d.ts.map
**/.storybook/certs/

# Linaria
.linaria-cache

# Vitest
**/coverage/**
!**/coverage/badges
!**/coverage/badges/*
# Where `toMatchScreenshot` writes the actual screenshot and the diff for a failed comparison.
# Only the baselines under `__screenshots__/` are committed.
.vitest-attachments/
# Output of the HTML reporter, which CI uploads as the `visual-report` artifact.
visual-report/

# Playwright (the browser driver behind Vitest browser mode)
**/playwright/.cache/

# oxlint
.oxlintcache

# Stylelint
.stylelintcache

# Babel
.babel-cache/
.cache-loader/

# General
.cache/
.temp
.tmp
.temp-credentials

# IDE
.vscode/
.idea/
*~

# OS
.DS_Store
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Worktrees
/.claude/worktrees
/.opencode/worktrees

# Exceptions
!/packages/elements/src/tokens/dist

# Claude Design sync
/.design-sync/sb-reference/
/.design-sync/learnings/
/.design-sync/.cache/
/.design-sync/node_modules
/.ds-sync/
/ds-bundle/
