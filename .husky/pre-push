#!/bin/sh
# Skip in CI environments
[ "$CI" = "true" ] && exit 0

# Check for a changeset on non-main branches
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" != "main" ]; then
  yarn changeset status --since=main 2>&1 || {
    echo ""
    echo "No changeset found for this branch."
    echo "Run 'yarn changeset' to add one before pushing."
    echo ""
    exit 1
  }
fi
