#!/bin/sh
# Uploading LFS objects is the pre-push hook's job, and nothing else does it: without this line a
# push succeeds while the objects the pointers name never leave the machine, and the next person to
# clone gets a fetch error. It runs before the CI guard below because a push from CI needs the
# upload just as much, and before anything else because `git lfs pre-push` reads the refs being
# pushed from stdin.
#
# `git lfs install` would normally write this hook itself. It cannot here, husky owning the file, so
# the line is tracked instead and the Yarn plugin at `.yarn/plugins/plugin-git-lfs.cjs` installs the
# filter config alone. The three other hooks that command offers to write, post-checkout,
# post-merge and post-commit, exist to apply the `lockable` attribute, which this repo does not use;
# content itself arrives through the smudge filter, no hook involved.
if command -v git-lfs > /dev/null 2>&1; then
  git lfs pre-push "$@" || exit $?
fi

# Skip in CI environments
[ "$CI" = "true" ] && exit 0

# Trunk is whichever branch `.changeset/config.json` declares as its
# baseBranch. Reading it here keeps this hook byte-identical across
# maintenance lines (main, lts, …): each line carries its own trunk
# pointer in the changesets config.
BASE_BRANCH=$(sed -n 's/.*"baseBranch":[[:space:]]*"\([^"]*\)".*/\1/p' .changeset/config.json | head -n1)

if [ -z "$BASE_BRANCH" ]; then
  echo "pre-push: could not read baseBranch from .changeset/config.json; skipping changeset check."
  exit 0
fi

# Check for a changeset on non-trunk branches
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" != "$BASE_BRANCH" ]; then
  unset GIT_DIR GIT_INDEX_FILE
  yarn changeset status --since="$BASE_BRANCH" 2>&1 || {
    echo ""
    echo "No changeset found for this branch."
    echo "Run 'yarn changeset' to add one before pushing."
    echo ""
    exit 1
  }
fi
