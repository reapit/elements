{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "sourceMap": true,
    "inlineSources": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "module": "Preserve",
    "target": "ESNext",
    "diagnostics": true,
    "declaration": true,
    "declarationMap": true,
    "lib": ["ESNext", "dom"]
  }
}
