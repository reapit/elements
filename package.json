{
  "name": "@reapit/elements",
  "version": "5.0.0-beta.76",
  "description": "A React implementation of Reapit's Design System",
  "homepage": "https://github.com/reapit/elements#readme",
  "bugs": {
    "url": "https://github.com/reapit/elements/issues"
  },
  "license": "MIT",
  "author": "Will McVay <wmcvay@reapit.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reapit/elements.git"
  },
  "bin": "./bin/elements.js",
  "files": [
    "dist/",
    "assets/reset.css",
    "bin/"
  ],
  "type": "module",
  "imports": {
    "#src/*": {
      "types": [
        "./src/*.js",
        "./src/*/index.js",
        "./dist/types/*/index.d.ts"
      ],
      "import": "./src/*"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/js/index.js"
    },
    "./core/*": {
      "types": "./dist/types/core/*/index.d.ts",
      "import": "./dist/js/core/*.js"
    },
    "./deprecated/*": {
      "types": "./dist/types/deprecated/*/index.d.ts",
      "import": "./dist/js/deprecated/*.js"
    },
    "./icons/*": {
      "types": "./dist/types/icons/*.d.ts",
      "import": "./dist/js/icons/*.js"
    },
    "./lab/*": {
      "types": "./dist/types/lab/*/index.d.ts",
      "import": "./dist/js/lab/*.js"
    },
    "./polyfills/*": {
      "types": "./dist/types/polyfills/*/index.d.ts",
      "import": "./dist/js/polyfills/*.js"
    },
    "./utils/*": {
      "types": "./dist/types/utils/*/index.d.ts",
      "import": "./dist/js/utils/*.js"
    },
    "./reset.css": "./assets/reset.css",
    "./styles.css": "./dist/js/style.css",
    "./dist/index.css": "./dist/js/style.css"
  },
  "scripts": {
    "build": "yarn build:types && yarn build:lib && yarn build:codemods && yarn build:storybook",
    "build:codemods": "yarn build:codemods:export-map && yarn build:codemods:compile && yarn build:codemods:manifest",
    "build:codemods:export-map": "node --experimental-strip-types codemods/rewrite-v5-imports/generate-export-map.ts",
    "build:codemods:compile": "node --experimental-strip-types codemods/build.ts",
    "build:codemods:manifest": "node --experimental-strip-types codemods/generate-manifest.ts",
    "build:storybook": "rimraf public/dist && NODE_ENV=production storybook build -o public/dist",
    "build:lib": "vite build",
    "build:types": "tsc --project tsconfig.build.json",
    "commit": "yarn test run --coverage --silent && yarn coverage:badges && yarn lint && yarn check",
    "coverage:badges": "yarn make-badge branches && yarn make-badge functions && yarn make-badge lines && yarn make-badge statements",
    "generate:icons": "yarn node --experimental-strip-types src/icons/bin/generate-icons.ts",
    "generate:tokens": "yarn generate:tokens:preprocess && yarn generate:tokens:css",
    "generate:tokens:css": "yarn node --experimental-strip-types ./src/tokens/build.ts",
    "generate:tokens:preprocess": "yarn node ./src/tokens/preprocess.js",
    "lint": "yarn lint:es && yarn lint:css && yarn lint:fmt",
    "lint:css": "stylelint \"src/**/*.{ts,tsx,js,jsx,css}\"",
    "lint:es": "oxlint --fix src",
    "lint:fmt": "oxfmt",
    "check": "yarn check:types && yarn check:lint",
    "check:types": "tsc --noEmit",
    "check:lint": "yarn check:lint:css && yarn check:lint:es && yarn check:lint:fmt",
    "check:lint:css": "stylelint \"src/**/*.{ts,tsx,js,jsx,css}\"",
    "check:lint:es": "oxlint src",
    "check:lint:fmt": "oxfmt --check",
    "make-badge": "coverage-badges --type ${0} --source coverage/report/coverage-summary.json --output coverage/badges/badge-${0}.svg --jsonPath total.${0}.pct",
    "publish": "yarn npm publish --access public",
    "deploy": "yarn node scripts/cdk/bin/rpt-cdk.cjs deploy",
    "start": "storybook dev -p 6006",
    "test": "vitest",
    "visual-test": "yarn build:storybook && yarn playwright test"
  },
  "dependencies": {
    "@linaria/core": "7.0.0",
    "@linaria/react": "7.0.1",
    "@oddbird/css-anchor-positioning": "^0.9.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@changesets/cli": "^2.29.8",
    "@changesets/get-github-info": "^0.8.0",
    "@changesets/types": "^6.1.0",
    "@figma/code-connect": "^1.4.1",
    "@linaria/postcss-linaria": "7.0.0",
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "10.2.12",
    "@storybook/addon-docs": "10.2.12",
    "@storybook/addon-links": "10.2.12",
    "@storybook/cli": "10.2.12",
    "@storybook/react-vite": "10.2.12",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.19.11",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@wyw-in-js/babel-preset": "1.0.6",
    "@wyw-in-js/vite": "1.0.6",
    "aws-cdk": "2.137.0",
    "aws-cdk-lib": "2.137.0",
    "aws-sdk": "2.1597.0",
    "colord": "2.9.3",
    "concurrently": "8.2.2",
    "constructs": "10.3.0",
    "coverage-badges-cli": "2.2.0",
    "dashify": "2.0.0",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.7.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "postcss": "8.5.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-syntax-highlighter": "15.6.6",
    "rimraf": "6.1.3",
    "snyk": "^1.1302.1",
    "storybook": "10.2.12",
    "style-dictionary": "5.3.2",
    "stylelint": "17.3.0",
    "ts-morph": "^27.0.2",
    "ts-node": "10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": ">=18.0.2",
    "react-dom": ">=18.0.2"
  },
  "resolutions": {
    "brace-expansion@npm:^1.1.7": "^2.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@4.12.0",
  "snyk": true
}
