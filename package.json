{
  "name": "gbl-ds-elements",
  "private": true,
  "description": "Monorepo for Reapit's Design System: the published library lives in packages/elements",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reapit-global/gbl-ds-elements.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "yarn workspaces foreach --all --topological-dev --exclude gbl-ds-elements run build",
    "build:docs": "yarn workspaces foreach --all --topological-dev --exclude gbl-ds-elements run build:docs",
    "build:lib": "yarn workspaces foreach --all --topological-dev --exclude gbl-ds-elements run build:lib",
    "check": "yarn workspaces foreach --all --topological-dev --exclude gbl-ds-elements run check && yarn check:lint:es && yarn check:lint:fmt",
    "check:lint:es": "oxlint packages/elements/src",
    "check:lint:fmt": "oxfmt --check",
    "commit": "yarn test:ci && yarn workspace @reapit/elements run coverage:badges && yarn lint && yarn check",
    "eval:dev": "yarn workspace @reapit/elements-evals run eval:dev",
    "generate:tokens": "yarn workspaces foreach --all --topological-dev --exclude gbl-ds-elements run generate:tokens",
    "eval:run": "yarn workspace @reapit/elements-evals run eval:run",
    "lint": "yarn workspaces foreach --all --exclude gbl-ds-elements run lint && yarn lint:es && yarn lint:fmt",
    "lint:es": "oxlint --fix packages/elements/src",
    "lint:fmt": "oxfmt",
    "start": "yarn workspace @reapit/elements run start",
    "test": "yarn workspace @reapit/elements run test",
    "test:ci": "yarn workspaces foreach --all --exclude gbl-ds-elements run test:ci",
    "visual-test": "yarn workspace @reapit/elements run visual-test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.2.0",
    "changelog-format": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
  },
